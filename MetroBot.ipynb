      " \"networkx\": \"networkx\",\n",
      " \"ipywidgets\": \"ipywidgets\",\n",
      " \"dotenv\": \"python-dotenv\",\n",
      " \"groq\": \"groq\",\n",
      " \"ollama\": \"ollama\",\n",
      "}\n"
    "faltantes = [pip_nome for modulo, pip_nome in pacotes.items() if importlib.util.find_spec(modulo) is None]\n",
    "if faltantes:\n",
    "    print(\"Instalando dependências ausentes:\", \", \".join(faltantes))\n",
